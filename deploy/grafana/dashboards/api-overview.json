{
  "uid": "scrobbler-api-overview",
  "title": "Scrobbler: API overview",
  "description": "Rate, errors and duration for every endpoint of the Scrobbler API.",
  "tags": [
    "scrobbler"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "label": "Endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(scrobbler_http_requests_total, endpoint)",
          "refId": "var"
        },
        "definition": "label_values(scrobbler_http_requests_total, endpoint)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "scrobbler"
      ],
      "asDropdown": true,
      "title": "Scrobbler",
      "includeVars": false
    }
  ],
  "panels": [
